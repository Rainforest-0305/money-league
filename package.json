{
  "name": "moneyleague-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Track E - Money League (머니리그) web client. React + TypeScript + Vite + react-i18next.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check_i18n_keys.mjs",
    "gen:data": "node scripts/gen_data.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ait:build": "npm run clean && node scripts/ait_build.mjs && python scripts/ait_freshness.py",
    "check:i18n:usage": "node scripts/check_i18n_usage.mjs",
    "check:i18n:selftest": "node scripts/check_i18n_usage.mjs --selftest",
    "check:all": "npm run check:i18n && npm run check:i18n:selftest && npm run check:i18n:usage && npm run check:roster && npm run check:schema && npm run check:paths && npm run check:undo && npm run check:emoji:selftest && npm run check:emoji && npm run check:copy:selftest && npm run check:copy && npm run check:strikes && npm run check:optarb && npm run check:loans && npm run check:chartwin && npm run check:analytics && npm run check:attend && npm run check:copyplan && npm run check:privacy && npm run check:promo && npm run check:interstitial && npm run typecheck",
    "check:paths": "node scripts/check_position_paths.mjs",
    "check:undo": "node scripts/check_undo_paths.mjs --selftest && node scripts/check_undo_paths.mjs",
    "check:emoji": "node scripts/check_emoji.mjs",
    "check:emoji:selftest": "node scripts/check_emoji.mjs --selftest",
    "check:copy": "node scripts/check_copy.mjs",
    "check:strikes": "node scripts/check_strikes.mjs --selftest && node scripts/check_strikes.mjs",
    "check:optarb": "node scripts/check_option_arb.mjs --selftest && node scripts/check_option_arb.mjs",
    "check:copy:selftest": "node scripts/check_copy.mjs --selftest",
    "check:chartwin": "node scripts/check_chart_windows.mjs --selftest && node scripts/check_chart_windows.mjs",
    "check:schema": "node scripts/check_ticker_schema.mjs",
    "check:analytics": "node scripts/check_analytics.mjs --selftest && node scripts/check_analytics.mjs",
    "check:privacy": "node scripts/check_privacy_keys.mjs --selftest && node scripts/check_privacy_keys.mjs",
    "check:copyplan": "node scripts/check_copy_plan.mjs --selftest && node scripts/check_copy_plan.mjs",
    "check:attend": "node scripts/check_attendance.mjs --selftest && node scripts/check_attendance.mjs",
    "check:roster": "node scripts/check_roster_mix.mjs",
    "check:promo": "node scripts/check_promo_hooks.mjs --selftest && node scripts/check_promo_hooks.mjs",
    "check:interstitial": "node scripts/check_interstitial.mjs --selftest",
    "check:loans": "node scripts/check_loans.mjs --selftest && node scripts/check_loans.mjs"
  },
  "dependencies": {
    "@apps-in-toss/bridge-core": "2.10.8",
    "@apps-in-toss/web-framework": "2.10.8",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
